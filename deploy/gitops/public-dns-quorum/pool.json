{
  "schema_version": 1,
  "namespace": "heterocloud-dns",
  "dns_namespace": "heterocloud-dns",
  "dns_resource": "heterocloud-web-gateways",
  "state_resource": "public-dns-quorum-state",
  "members": [
    {
      "id": "ichikawap1",
      "node": "ichikawap1",
      "vote_resource": "public-dns-vote-ichikawap1"
    },
    {
      "id": "uc-k8sp5",
      "node": "uc-k8sp5",
      "vote_resource": "public-dns-vote-uc-k8sp5"
    }
  ],
  "origins": [
    {
      "id": "ichikawap1",
      "address": "163.220.236.61"
    },
    {
      "id": "uc-k8sp5",
      "address": "163.220.236.45"
    }
  ],
  "witness": {
    "id": "cloudflare-witness",
    "url": "https://heteronetwork-public-dns-witness.fasutotesuto.workers.dev/v1/probe"
  },
  "overlay_dns": {
    "hostname": "console.heteronetwork.internal",
    "timeout_seconds": 1,
    "targets": [
      {"id": "ichikawap1", "address": "10.250.0.10"},
      {"id": "uc-k8sp5", "address": "10.250.0.2"}
    ]
  },
  "records": [
    "heterocloud.mizuame.app",
    "flow.heterocloud.mizuame.app",
