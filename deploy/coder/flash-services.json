          "security_groups": [
            "database"
          ],
          "vpc_id": "01a1cb47-4e1c-7d10-b41f-83f29e098939"
        },
        "ports": [
          {
            "container_port": 5432,
            "name": "postgres",
            "protocol": "tcp",
            "service_port": 5432
          }
        ],
        "region": "heteronet-global",
        "replicas": 1,
        "rootfs_storage_gib": 1,
        "secret_env": {
          "POSTGRES_PASSWORD": "postgres-password"
        }
      }
    },
