          "POSTGRES_DB": "coder",
          "POSTGRES_USER": "coder"
        },
        "ephemeral_storage_gib": 8,
        "exposure": {
          "allowed_source_cidrs": [],
          "denied_source_cidrs": [],
          "traffic_mode": "forwarded",
          "type": "internal"
        },
        "image": "docker.io/library/postgres:17",
        "memory_mib": 512,
        "metadata": {
          "application": "coder",
          "managed_by": "coder-dind"
        },
        "network": {
