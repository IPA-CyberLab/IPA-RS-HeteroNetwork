{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heteronet-http-members",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "containers": [{
    "class_name": "HeteronetMember",
    "scheduling_policy": "durable_object",
    "images": {
      "base": {
        "dockerfile": "../../../docker/http-mesh/Dockerfile",
        "build_context": "../../../clients/headless"
      }
    }
  }],
  "durable_objects": { "bindings": [{ "name": "MEMBERS", "class_name": "HeteronetMember" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HeteronetMember"] }],
  "vars": { "HETERONETWORK_ENDPOINT": "https://REPLACE_WITH_CONTROL_ORIGIN" }
}
