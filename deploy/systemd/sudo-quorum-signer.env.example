# Each VM uses its own share and identity from the reviewed frozen sudo manifest.
# Replace all placeholders; this file intentionally cannot start a signer as-is.
HETERONETWORK_ADMIN_QUORUM_NODE_ID=REPLACE_WITH_THIS_VOTER_ID
HETERONETWORK_ADMIN_QUORUM_LISTEN=REPLACE_WITH_THIS_VPN_IP_AND_DEDICATED_PORT
HETERONETWORK_VPN_POOL=10.250.0.0/16
# Must exactly match the issuer pinned in policy.json; sudo v2 requires HTTPS.
HETERONETWORK_WEB_OIDC_ISSUER_URL=https://REPLACE_WITH_TRUSTED_ISSUER/realms/heteronetwork
HETERONETWORK_WEB_OIDC_CLIENT_ID=heteronetwork-web
HETERONETWORK_WEB_OIDC_REQUIRED_EMAIL=REPLACE_WITH_OWNER_EMAIL
HETERONETWORK_ADMIN_QUORUM_OWNER_SUBJECT=REPLACE_WITH_IMMUTABLE_KEYCLOAK_USER_ID
# Never set a rotation anchor in this process. Use a separate reviewed ceremony.
