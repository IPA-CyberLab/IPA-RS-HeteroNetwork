[Unit]
Description=Reconcile automatic HeteroNetwork Keycloak HA placement
Wants=network-online.target heteronetwork-agent.service
After=network-online.target heteronetwork-agent.service heteronetwork-keycloak-prepare.service
ConditionPathExists=/etc/heteronetwork/keycloak-autopilot.env
ConditionPathExists=/opt/heteronetwork/libexec/keycloak-autopilot.sh

[Service]
Type=oneshot
ExecStart=/opt/heteronetwork/libexec/keycloak-autopilot.sh reconcile
ConfigurationDirectory=heteronetwork/keycloak heteronetwork/keycloak-backchannel heteronetwork/keycloak-edge-proxy
ConfigurationDirectoryMode=0750
RuntimeDirectory=heteronetwork-keycloak-autopilot
RuntimeDirectoryMode=0700
StateDirectory=heteronetwork-keycloak-autopilot
StateDirectoryMode=0700
TimeoutStartSec=240s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/etc/heteronetwork/keycloak
ReadWritePaths=/etc/heteronetwork/keycloak-backchannel
ReadWritePaths=/etc/heteronetwork/keycloak-edge-proxy
ReadWritePaths=/etc/systemd/system
# Edge-only nodes do not install the full Keycloak tree. A missing optional
# path must not prevent them from reconciling their local HAProxy endpoint.
ReadWritePaths=-/opt/heteronetwork/keycloak-26.6.4/conf
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
