[Unit]
Description=HeteroNetwork public customer console edge
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/heteronetwork/customer-console/customer-console.env
ConditionPathExists=/opt/heteronetwork/customer-console/webconsole/server.mjs
ConditionPathExists=/opt/heteronetwork/libexec/customer-console-start

[Service]
Type=simple
User=heteronetwork-customer-console
Group=heteronetwork-customer-console
EnvironmentFile=/etc/heteronetwork/customer-console/customer-console.env
WorkingDirectory=/opt/heteronetwork/customer-console
ExecStart=/opt/heteronetwork/libexec/customer-console-start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
LimitNOFILE=8192
UMask=0077
StateDirectory=heteronetwork-customer-console
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
