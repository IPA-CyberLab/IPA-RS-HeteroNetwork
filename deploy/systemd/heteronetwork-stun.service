[Unit]
Description=HeteroNetwork automatically promoted STUN service
Wants=network-online.target
Requires=heteronetwork-agent.service
After=network-online.target heteronetwork-agent.service
BindsTo=heteronetwork-agent.service
ConditionPathExists=/etc/heteronetwork/public-services/udp-services.env

[Service]
Type=simple
User=heteronetwork-services
Group=heteronetwork-services
EnvironmentFile=/etc/heteronetwork/public-services/udp-services.env
ExecStart=/opt/heteronetwork/bin/iparsd stun
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
