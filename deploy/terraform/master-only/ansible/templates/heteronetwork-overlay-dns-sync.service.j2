[Unit]
Description=Synchronize HeteroNetwork overlay DNS records from Kubernetes
After=network-online.target kubelet.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=KUBECTL={{ overlay_dns_kubectl.stdout }}
Environment=KUBECONFIG=/etc/kubernetes/admin.conf
Environment=EFFECTIVE_CONFIGMAP_NAMESPACE=kube-system
Environment=EFFECTIVE_CONFIGMAP_NAME=heteronetwork-overlay-dns-effective
Environment=OVERLAY_DNS_DESTINATION=/var/lib/heteronetwork/overlay-dns-records.json
Environment=RECONCILE_INTERVAL_SECONDS=5
ExecStart=/usr/bin/python3 -B /usr/local/libexec/heteronetwork-overlay-dns-sync host-sync
Restart=always
RestartSec=2s
UMask=0022
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/heteronetwork
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
